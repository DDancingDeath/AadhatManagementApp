rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Bills collection - all authenticated users can read/write
    match /bills/{billId} {
      allow read, write: if isSignedIn();
    }
    
    // Sales collection - all authenticated users can read/write
    match /sales/{saleId} {
      allow read, write: if isSignedIn();
    }
    
    // Items collection - all authenticated users can read/write
    match /items/{itemId} {
      allow read, write: if isSignedIn();
    }
    
    // Settings collection - all authenticated users can read/write
    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }
    
    // Expenses collection - all authenticated users can read/write
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }
    
    // Withdrawals collection - all authenticated users can read/write
    match /withdrawals/{withdrawalId} {
      allow read, write: if isSignedIn();
    }
    
    // Users collection - all authenticated users can read/write
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
    
    // Retail sales collection - all authenticated users can read/write
    match /retailSales/{saleId} {
      allow read, write: if isSignedIn();
    }
    
    // Item frequency collection - all authenticated users can read/write
    match /itemFrequency/{docId} {
      allow read, write: if isSignedIn();
    }
    
    // Allow all other collections for authenticated users (catch-all for any new collections)
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
